<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_3"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingBottom="@dimen/space_3">

    <FrameLayout
        android:layout_width="@dimen/pebble_size_list"
        android:layout_height="@dimen/pebble_size_list"
        android:importantForAccessibility="no">

        <de.lembergmax.gitmax.ui.common.PebbleView
            android:id="@+id/pebble"
            android:layout_width="@dimen/pebble_size_list"
            android:layout_height="@dimen/pebble_size_list" />

        <ImageView
            android:id="@+id/check"
            android:importantForAccessibility="no"
            android:layout_width="@dimen/pebble_size_list"
            android:layout_height="@dimen/pebble_size_list"
            android:alpha="0"
            android:background="@drawable/bg_selected_tile"
            android:scaleType="center"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorOnPrimary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:breakStrategy="balanced"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.GitMax.CodeSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/facts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/branch"
                style="@style/Widget.GitMax.Fact"
                android:ellipsize="end"
                android:maxWidth="160dp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/ahead"
                style="@style/Widget.GitMax.Fact"
                android:layout_marginStart="@dimen/space_3" />

            <TextView
                android:id="@+id/behind"
                style="@style/Widget.GitMax.Fact"
                android:layout_marginStart="@dimen/space_3" />

            <TextView
                android:id="@+id/changed"
                style="@style/Widget.GitMax.Fact"
                android:layout_marginStart="@dimen/space_3" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
