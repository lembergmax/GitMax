<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/old_number"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_1"
        android:textAppearance="@style/TextAppearance.GitMax.CodeSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/new_number"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_1"
        android:textAppearance="@style/TextAppearance.GitMax.CodeSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/sign"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textAppearance="@style/TextAppearance.GitMax.Code"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/space_2"
        android:textAppearance="@style/TextAppearance.GitMax.Code"
        android:textColor="?attr/colorOnSurface" />
</LinearLayout>
