<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <LinearLayout
        android:id="@+id/left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/left_number"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingStart="@dimen/space_1"
            android:paddingEnd="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.GitMax.CodeSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/left_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.GitMax.Code"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:id="@+id/right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/right_number"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingStart="@dimen/space_1"
            android:paddingEnd="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.GitMax.CodeSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/right_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.GitMax.Code"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
</LinearLayout>
