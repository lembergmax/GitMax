<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_3"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingBottom="@dimen/space_3">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no">

        <TextView
            android:id="@+id/tile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_provider_tile"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSecondaryContainer" />

        <ImageView
            android:id="@+id/check"
            android:importantForAccessibility="no"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0"
            android:background="@drawable/bg_selected_tile"
            android:scaleType="center"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorOnPrimary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:breakStrategy="balanced"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/facts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
