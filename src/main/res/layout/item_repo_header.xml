<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingBottom="@dimen/space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <de.lembergmax.gitmax.ui.common.PebbleView
            android:id="@+id/pebble"
            android:layout_width="@dimen/pebble_size_header"
            android:layout_height="@dimen/pebble_size_header"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:maxLines="2"
                android:breakStrategy="balanced"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/branch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.GitMax.Code"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.GitMax.CodeSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/lfs_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:background="@drawable/bg_banner_info"
        android:padding="@dimen/space_4"
        android:text="@string/repo_lfs_note"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSecondaryContainer"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/operation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/operation_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/operation_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:indeterminate="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/failure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:background="@drawable/bg_banner_error"
        android:orientation="vertical"
        android:padding="@dimen/space_4"
        android:visibility="gone">

        <TextView
            android:id="@+id/failure_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnErrorContainer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/failure_dismiss"
                style="@style/Widget.GitMax.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repo_banner_dismiss" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/failure_action"
                style="@style/Widget.GitMax.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_update"
            style="@style/Widget.GitMax.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/repo_action_update"
            android:paddingStart="@dimen/space_1"
            android:paddingEnd="@dimen/space_1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            app:icon="@drawable/ic_sync"
            app:cornerRadius="@dimen/radius_l"
            app:iconGravity="top" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_commit"
            style="@style/Widget.GitMax.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/repo_action_commit"
            android:paddingStart="@dimen/space_1"
            android:paddingEnd="@dimen/space_1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            app:icon="@drawable/ic_commit"
            app:cornerRadius="@dimen/radius_l"
            app:iconGravity="top" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_push"
            style="@style/Widget.GitMax.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/repo_action_push"
            android:paddingStart="@dimen/space_1"
            android:paddingEnd="@dimen/space_1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            app:icon="@drawable/ic_cloud_upload"
            app:cornerRadius="@dimen/radius_l"
            app:iconGravity="top" />
    </LinearLayout>
</LinearLayout>
