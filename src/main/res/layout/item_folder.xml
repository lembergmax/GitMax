<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingBottom="@dimen/space_2">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/repo_marker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:background="@drawable/bg_provider_tile"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingVertical="2dp"
        android:text="@string/picker_repo_marker"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSecondaryContainer"
        android:visibility="gone" />
</LinearLayout>
