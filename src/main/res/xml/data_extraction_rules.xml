<?xml version="1.0" encoding="utf-8"?>
<!-- Nichts verlässt das Gerät: weder Cloud-Sicherung noch Geräte-zu-Gerät-Übertragung. Token und SSH-Schlüssel liegen
     ohnehin verschlüsselt mit einem Keystore-Schlüssel, der sich nicht übertragen lässt. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
