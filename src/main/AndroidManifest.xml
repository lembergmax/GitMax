<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Git-Hosts und Anbieter-APIs; sonst keine Netzwerkziele. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Klonen, Aktualisieren und Pushen laufen in einem Vordergrunddienst weiter, wenn die App im Hintergrund ist. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Geklonte Repos liegen in einem öffentlichen Ordner, damit Dateimanager und Editoren sie sehen.
        JGit arbeitet auf echten Dateipfaden, der Storage Access Framework reicht dafür nicht.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
        Predictive Back bleibt aus (enableOnBackInvokedCallback=false): Mit eingeschalteter Option blieben nach der Zurück-Taste
        (auch Drei-Tasten-Navigation) alte Ansichten stehen oder der Inhalt fehlte in der Zugänglichkeits-Hierarchie, bei
        Material-Übergängen (Fragment 1.8.5). Mit Wischgeste war es in Ordnung. Auf Android 16 gilt Predictive Back für
        targetSdk 36 sonst automatisch. Erneut prüfen, wenn Fragment oder Navigation aktualisiert werden.
    -->
    <application
        android:name=".GitMaxApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GitMax"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GitMax.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Teilen → Klonen: nimmt nur Text entgegen; ShareTarget lässt nur streng geprüfte https-Adressen durch,
                 geklont wird erst nach Bestätigung im Klon-Sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".ops.GitOperationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
